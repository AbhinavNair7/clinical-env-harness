# Environment — never commit secrets
.env*
!.env.example

# Build output
dist/
build/

# OS / logs
.DS_Store
*.log

# Python
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run output (regenerated by clinical-env run)
runs/
logs/

# Downloaded source data (regenerated by `clinical-env sources pull` / docs/case-sourcing.md)
sources/**/fulltext/
mimic/

# Publisher-copyright reference texts for the retrieval test (re-fetch from sources/reference/MANIFEST.md)
sources/reference/*.txt
